# NEPSE TMS API Configuration
TMS_HOST=tms01.nepsetms.com.np
TMS_BASE_URL=https://tms01.nepsetms.com.np

# Authentication Variables (Get these from browser after login)
XSRF_TOKEN=your_xsrf_token_here
RID_COOKIE=your_rid_cookie_here
HOST_SESSION_ID=your_host_session_id_here
ACCESS_TOKEN=your_access_token_here

# Client Information
REQUEST_OWNER=175309
MEMBER_CODE=1

# Order Defaults (can be overridden via CLI)
DEFAULT_ORDER_TYPE=LMT
DEFAULT_ORDER_VALIDITY=DAY
DEFAULT_PRODUCT_CODE=CNC
DEFAULT_INSTRUMENT_TYPE=EQ
DEFAULT_BUY_OR_SELL=1

# IPO Sniper Settings (duration in minutes)
IPO_SNIPER_DURATION_MINUTES=2
