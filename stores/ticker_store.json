{
    "_comment": "Ticker store for NEPSE securities. Maps ticker symbols to their security_id and exchange_security_id",
    "_format": {
        "TICKER": {
            "security_id": 123,
            "exchange_security_id": 456,
            "fetch_id": 123,
            "name": "Company Name (Optional)"
        }
    },
    "_format_with_host_mapping": {
        "TICKER": {
            "security_id": 123,
            "exchange_security_id": 456,
            "fetch_id": {
                "tms76.nepsetms.com.np": 123,
                "tms77.nepsetms.com.np": 124
            },
            "name": "Company Name (Optional)"
        }
    },
    "_instructions": {
        "security_id": "Security ID used for placing orders",
        "exchange_security_id": "Exchange security ID used for placing orders",
        "fetch_id": "(Optional) Security ID used for fetching LTP. Can be either: (1) a single integer (applies to all hosts), or (2) a dictionary mapping host to fetch_id for host-specific IDs. If not provided, uses security_id",
        "name": "(Optional) Company name for reference"
    },
